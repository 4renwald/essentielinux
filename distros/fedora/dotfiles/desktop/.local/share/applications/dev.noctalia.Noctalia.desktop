[Desktop Entry]
Type=Application
Name=Noctalia
Comment=Configure the Noctalia desktop shell
Exec=sh -c "noctalia msg settings-open || { noctalia --daemon && noctalia msg settings-open; }"
Icon=noctalia
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
Keywords=desktop;shell;wayland;settings;
